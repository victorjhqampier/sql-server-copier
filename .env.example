# ============ SQL Server origen ============
SOURCE_SQLSERVER_HOST=localhost
SOURCE_SQLSERVER_USER=sa
SOURCE_SQLSERVER_PASSWORD=change_me
SOURCE_SQLSERVER_DATABASE=DB_Origen

# ============ SQL Server destino ============
TARGET_SQLSERVER_HOST=localhost
TARGET_SQLSERVER_USER=sa
TARGET_SQLSERVER_PASSWORD=change_me
TARGET_SQLSERVER_DATABASE=DB_Destino

# ============ Procesamiento ============
# Tamano de lote para la migracion de datos (SELECT/INSERT)
BATCH_SIZE=1000
# Si la tabla destino ya existe: true la elimina antes de recrear, false la omite
DROP_IF_EXISTS=false
