# ============ Kafka ============
KAFKA_TOPIC_PREFIX=cdc

# ============ Procesamiento ============
# Tamano de lote para la migracion de datos (SELECT/INSERT)
BATCH_SIZE=500
# Si la tabla destino ya existe: true la elimina antes de recrear, false la omite
DROP_IF_EXISTS=false
