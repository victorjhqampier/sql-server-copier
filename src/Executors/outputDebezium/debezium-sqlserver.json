{
  "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
  "tasks.max": "1",
  "database.hostname": "${env:SQLSERVER_HOST}",
  "database.port": "${env:SQLSERVER_PORT}",
  "database.user": "${env:DEBEZIUM_USER}",
  "database.password": "${env:DEBEZIUM_PASSWORD}",
  "database.names": "${env:SQLSERVER_DB}",
  "database.encrypt": "false",
  "database.trustServerCertificate": "true",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "schema.history.internal.kafka.bootstrap.servers": "${env:KAFKA_BOOTSTRAP_SERVERS}",
  "schema.history.internal.kafka.topic": "${env:SCHEMA_HISTORY_TOPIC}",
